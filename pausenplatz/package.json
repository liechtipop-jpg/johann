{
  "name": "pausenplatz",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer-Spiele ohne Anmeldung: Raum erstellen, Code teilen, zusammen spielen.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 --test-force-exit \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 --test-force-exit \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}